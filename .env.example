# Database Connection URL
# For local PostgreSQL with Docker Compose:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinical_trial
# For local standalone SQLite development (requires no Docker):
# DATABASE_URL=sqlite:///clinical_trial.db

# Pipeline Configuration
PIPELINE_NAME=clinical-trial-etl
PIPELINE_VERSION=1.0.0
INPUT_DATA_DIR=data/raw
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit Configuration
STREAMLIT_PORT=8501
